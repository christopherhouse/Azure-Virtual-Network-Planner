# Application Insights Configuration
# Get this from Azure Portal > Application Insights > Connection String
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=

# Application version (optional, for telemetry tagging)
NEXT_PUBLIC_APP_VERSION=0.1.0

# SEO Configuration
# Your production site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://azvnetplanner.chrishou.se

# API Health Check URL (server-side only)
# Used by /healthz endpoint to verify API is reachable
# Defaults to https://api.azvnetplanner.chrishou.se/healthz if not set
API_HEALTH_URL=https://api.azvnetplanner.chrishou.se/healthz
